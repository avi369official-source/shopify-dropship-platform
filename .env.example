# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"


# App Configuration
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Mode: Set to "true" to simulate Shopify & Meta APIs without live merchant credentials
MOCK_MODE=true

# Shopify Store Credentials (Optional when MOCK_MODE=true)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_WEBHOOK_SECRET="mock_webhook_secret_key"

# Meta / Facebook Marketing Credentials (Optional when MOCK_MODE=true)
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_CATALOG_ID=""

# AI Provider Credentials (Optional - built-in smart fallback if not provided)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
